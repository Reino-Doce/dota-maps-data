{
  "name": "@reino-doce/dota-maps-data",
  "version": "0.1.0",
  "description": "Prebuilt Dota 2 map data and reusable map calculations.",
  "dotaMapsData": {
    "currentPatch": "741"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Reino-Doce/dota-maps-data.git"
  },
  "homepage": "https://github.com/Reino-Doce/dota-maps-data#readme",
  "bugs": {
    "url": "https://github.com/Reino-Doce/dota-maps-data/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25",
    "npm": ">=12.1.0"
  },
  "packageManager": "npm@12.1.0",
  "files": [
    "dist/",
    "manifest.json",
    "scripts/",
    "src/",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./node": "./src/node/index.mjs",
    "./node/game-files": "./src/node/game-files.mjs",
    "./vision": {
      "browser": "./dist/vision.browser.mjs",
      "node": "./dist/vision.node.mjs",
      "default": "./dist/vision.browser.mjs"
    },
    "./manifest.json": "./manifest.json",
    "./data/*": "./assets/data/*",
    "./image/*": "./assets/img/*",
    "./package.json": "./package.json",
    "./*/mapdata.json": "./assets/data/*/mapdata.json",
    "./*/worlddata.json": "./assets/data/*/worlddata.json",
    "./latest/mapdata.json": "./assets/data/741/mapdata.json",
    "./latest/worlddata.json": "./assets/data/741/worlddata.json",
    "./latest/map_data.png": "./assets/img/741/map_data.png",
    "./latest/detailed.png": "./assets/img/741/minimaps/detailed.png",
    "./latest/simple.png": "./assets/img/741/minimaps/simple.png",
    "./latest/screenshot.jpg": "./assets/img/741/screenshot.jpg",
    "./latest/minimaps/detailed.png": "./assets/img/741/minimaps/detailed.png",
    "./latest/minimaps/simple.png": "./assets/img/741/minimaps/simple.png",
    "./latest/autumn/autumn.jpg": "./assets/img/741/autumn.jpg",
    "./latest/cavern/cavern.jpg": "./assets/img/741/cavern.jpg",
    "./latest/coloseum/coloseum.jpg": "./assets/img/741/coloseum.jpg",
    "./latest/default/default.jpg": "./assets/img/741/default.jpg",
    "./latest/desert/desert.jpg": "./assets/img/741/desert.jpg",
    "./latest/journey/journey.jpg": "./assets/img/741/journey.jpg",
    "./latest/jungle/jungle.jpg": "./assets/img/741/jungle.jpg",
    "./latest/reef/reef.jpg": "./assets/img/741/reef.jpg",
    "./latest/spring/spring.jpg": "./assets/img/741/spring.jpg",
    "./latest/summer/summer.jpg": "./assets/img/741/summer.jpg",
    "./latest/ti10/ti10.jpg": "./assets/img/741/ti10.jpg",
    "./latest/winter/winter.jpg": "./assets/img/741/winter.jpg"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "manifest": "node scripts/build-manifest.mjs",
    "generatejson": "node scripts/generate-legacy-geojson.mjs",
    "prepack": "node scripts/guard-publish.mjs",
    "prepublishOnly": "node scripts/guard-publish.mjs",
    "packages:prepare": "node scripts/prepare-npm-packages.mjs",
    "packages:verify": "node scripts/verify-npm-packages.mjs",
    "test": "node --test tests/*.test.mjs",
    "import:terrain": "node scripts/import-vision-grid.mjs",
    "import:wards": "node scripts/import-ward-grid.mjs",
    "import:structures": "node scripts/import-structure-footprints.mjs",
    "import:eyes": "node scripts/import-eyes-vision.mjs",
    "import:watchers": "node scripts/import-watchers.mjs",
    "import:building-vision": "node scripts/import-building-vision.mjs",
    "import:mapdata": "node scripts/import-mapdata.mjs",
    "import:source1-mapdata": "node scripts/import-source1-mapdata.mjs",
    "import:lanes": "node scripts/import-lane-geometry.mjs",
    "import:minimaps": "node scripts/import-vpk-minimaps.mjs",
    "import:neutral-spawn-boxes": "node scripts/import-neutral-spawn-boxes.mjs",
    "import:live-trees": "node scripts/import-live-trees.mjs",
    "map:scan-data": "node scripts/scan-mapdata.mjs",
    "import:overview": "node scripts/import-overview.mjs",
    "import:screenshot": "node scripts/import-screenshot.mjs",
    "images:reconstruct": "node scripts/reconstruct-default-images.mjs",
    "images:generate": "node scripts/generate-default-images.mjs",
    "map:skins": "node scripts/map-skins.mjs"
  },
  "dependencies": {
    "@turf/helpers": "7.4.0",
    "@turf/union": "7.4.0",
    "dota-vision-simulation": "0.17.0",
    "pngjs": "7.0.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "29.0.3",
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "16.0.3",
    "rollup": "4.63.5"
  }
}
